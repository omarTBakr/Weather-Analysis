# =====================================================================================
# Project configuration: the single source of truth for every setting.
# Read by src/weather/utils/config.py (pydantic-settings). Nested sections use "__",
# e.g. MODELS__LIGHTGBM__NUM_LEAVES. Lists/dicts use JSON syntax.
# Real environment variables override this file. Keep secrets OUT of this file
# (the Kaggle token stays in ~/.kaggle/kaggle.json); it is committed for reproducibility.
# Every DVC stage depends on this file, so editing it re-runs the pipeline.
# =====================================================================================

SEED=42

# ---- paths (relative to the project root) -------------------------------------------
PATHS__DATA_DIR=data
PATHS__MODELS_DIR=models
PATHS__REPORTS_DIR=reports

# ---- MLflow ------------------------------------------------------------------------
# empty TRACKING_URI -> sqlite:///<project root>/mlflow.db
MLFLOW__TRACKING_URI=
MLFLOW__EXPERIMENT_NAME=weather-forecasting
MLFLOW__ARTIFACTS_DIR=mlartifacts
MLFLOW__REGISTERED_MODEL_PREFIX=weather-temp

# ---- data source -------------------------------------------------------------------
DATA__KAGGLE_DATASET=nelgiriyewithana/global-weather-repository
DATA__KAGGLE_FILE=GlobalWeatherRepository.csv

# ---- cleaning ----------------------------------------------------------------------
# locations with fewer daily observations are dropped (one-off / mis-named entries)
CLEAN__MIN_OBS_PER_LOCATION=365
# per-location robust fence Q1 - k*IQR, Q3 + k*IQR (values outside are capped)
CLEAN__IQR_K=3.0
# heavy-tailed variables (precipitation, pollutants) are capped at this global quantile
CLEAN__HEAVY_TAIL_QUANTILE=0.999
# max consecutive missing days filled by time interpolation
CLEAN__INTERPOLATE_LIMIT=3
# a day whose median |temp - 15-day rolling median| across all cities exceeds this is a corrupted batch
CLEAN__CORRUPT_DAY_THRESHOLD_C=4.0

# ---- features ----------------------------------------------------------------------
FEATURES__TARGET=temperature_celsius
FEATURES__HORIZON=1
FEATURES__LAGS=[1, 2, 3, 7, 14]
FEATURES__ROLLING_WINDOWS=[3, 7, 14]
FEATURES__EXOG=["humidity", "pressure_mb", "wind_kph", "cloud", "precip_mm", "uv_index", "feels_like_celsius", "visibility_km", "gust_kph"]

# ---- time-based split --------------------------------------------------------------
SPLIT__TEST_DAYS=60
SPLIT__VAL_DAYS=60

# ---- global mean series ------------------------------------------------------------
# locations present on >= this share of days form the stable global mean
GLOBAL_SERIES__MIN_COVERAGE=0.95
GLOBAL_SERIES__FOURIER_ORDER=4
GLOBAL_SERIES__FUTURE_DAYS=90

# ---- anomaly detection -------------------------------------------------------------
ANOMALY__CONTAMINATION=0.01
ANOMALY__LOF_NEIGHBORS=35
ANOMALY__Z_THRESH=3.5
ANOMALY__GLOBAL_Z_THRESH=3.0
ANOMALY__SAMPLE_SIZE=60000

# ---- model hyper-parameters --------------------------------------------------------
MODELS__RIDGE__ALPHA=1.0

MODELS__RANDOM_FOREST__N_ESTIMATORS=200
MODELS__RANDOM_FOREST__MAX_DEPTH=16
MODELS__RANDOM_FOREST__MIN_SAMPLES_LEAF=5
MODELS__RANDOM_FOREST__MAX_FEATURES=0.5

MODELS__XGBOOST__N_ESTIMATORS=2000
MODELS__XGBOOST__LEARNING_RATE=0.05
MODELS__XGBOOST__MAX_DEPTH=7
MODELS__XGBOOST__SUBSAMPLE=0.8
MODELS__XGBOOST__COLSAMPLE_BYTREE=0.8
MODELS__XGBOOST__EARLY_STOPPING_ROUNDS=100

MODELS__LIGHTGBM__N_ESTIMATORS=3000
MODELS__LIGHTGBM__LEARNING_RATE=0.03
MODELS__LIGHTGBM__NUM_LEAVES=63
MODELS__LIGHTGBM__SUBSAMPLE=0.8
MODELS__LIGHTGBM__SUBSAMPLE_FREQ=1
MODELS__LIGHTGBM__COLSAMPLE_BYTREE=0.8
MODELS__LIGHTGBM__EARLY_STOPPING_ROUNDS=100

# ---- advanced analyses -------------------------------------------------------------
ANALYSES__SHAP_SAMPLE=3000
ANALYSES__PERMUTATION_SAMPLE=20000
